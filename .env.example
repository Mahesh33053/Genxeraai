# ==============================================================================
# GenXEraAI Environment Configuration (Example)
# Copy this file to .env or set these environment variables in Vercel / Host.
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000
BASE_PATH=/

# Public Website URL
VITE_SITE_URL=https://www.genxeraai.com

# Admissions & Contact WhatsApp Number (International format without leading '+')
VITE_WHATSAPP_NUMBER=919390560407
VITE_SUPPORT_EMAIL=genxeraai@gmail.com

# Backend Database URL (Optional - used by @workspace/api-server if deployed)
DATABASE_URL=postgresql://user:password@localhost:5432/genxeraai
